# Copy to ".env" and fill in values. Never commit ".env".

# ============================================================================
# Weather (host weather_producer.py)
# ============================================================================
OPENWEATHER_API_KEY=
OPENWEATHER_CITY=Los Angeles

# ============================================================================
# Kafka — two listeners exposed by Docker.
# Host processes (producers, spark, dashboard) use localhost:9092.
# Containerised workers use kafka:29092 (set in compose).
# ============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Topic names (kept in env so renaming is easy)
TOPIC_SENSORS=topic_sensors
TOPIC_GPS=topic_gps
TOPIC_CCTV=topic_cctv
TOPIC_CCTV_INFERRED=topic_cctv_inferred
TOPIC_WEATHER=topic_weather
TOPIC_SPEED_PREDICTIONS=topic_speed_predictions

# Used by infra/init_topics.py only.
KAFKA_NUM_PARTITIONS=3
KAFKA_RETENTION_MS=86400000

# ============================================================================
# Weather producer
# ============================================================================
WEATHER_TOPIC=topic_weather
WEATHER_POLL_SECONDS=300

# ============================================================================
# CCTV producer
# ============================================================================
CCTV_REPLAY_FPS=2
CCTV_FRAMES_PER_CAMERA=500
CCTV_SOURCE_LAYOUT=detrac
CCTV_LOOP=false

# ============================================================================
# MinIO — local S3-compatible object store
# Host fetch URL: http://localhost:9000/<bucket>/<key>
# Docker workers reach it at:  http://minio:9000
# ============================================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ENDPOINT_DOCKER=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cctv-frames
MINIO_PUBLIC_BASE_URL=http://localhost:9000/cctv-frames

# ============================================================================
# YOLO worker (read by yolo_worker/main.py via env)
# ============================================================================
YOLO_MODEL_PATH=weights/best.pt
YOLO_IMGSZ=480
YOLO_CONF=0.3
YOLO_FRAME_MAX_AGE_SEC=10
YOLO_WORKER_METRICS_PORT=9100
YOLO_MODEL_VERSION=yolo_traffic_model_v1

# ============================================================================
# Paths and Spark
# ============================================================================
DATA_DIR=./data
DELTA_DIR=./delta_tables
MODELS_DIR=./models

SPARK_DRIVER_MEMORY=4g
CONGESTION_THRESHOLD_MPH=20.0
